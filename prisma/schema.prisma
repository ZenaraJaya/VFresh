// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PremisesType {
  HOMEBASED
  OTHER
}

enum ScheduleMode {
  NONE
  RANGE
  EVERYDAY
  CUSTOM
}

model Vendor {
  id                 String       @id @default(cuid())
  email              String       @unique
  password           String
  businessName       String
  slug               String       @unique
  description        String?
  phone              String?
  /// Rider / runner contact for late or no-response pings.
  deliveryPhone      String?
  address            String?
  registrationNumber String?
  premisesType       PremisesType @default(OTHER)
  logo               String?
  status             VendorStatus @default(PENDING)
  /// Manual override: false = force closed even during scheduled hours.
  isOpen             Boolean      @default(true)
  /// When false, Open/Close ignore the schedule until Save (hours) again.
  followSchedule     Boolean      @default(true)
  scheduleMode       ScheduleMode @default(NONE)
  /// RANGE mode: auto-close at this time.
  closesAt           DateTime?
  /// RANGE mode: auto-reopen at this time.
  closedUntil        DateTime?
  /// EVERYDAY mode: "HH:mm"
  openTime           String?
  /// EVERYDAY mode: "HH:mm"
  closeTime          String?
  /// Optional pause during open hours, "HH:mm"
  lunchStart         String?
  lunchEnd           String?
  /// CUSTOM mode: { "0"|"1"|...|"6": { open, close } | null } (0=Sun)
  weeklyHours        Json?
  warningCount       Int          @default(0)
  lastWarningAt      DateTime?
  lastWarningReason  String?
  warningHistory     Json         @default("[]")
  suspendReason      String?
  suspendedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  menuItems MenuItem[]
  orders    Order[]
  recurringOrders RecurringOrder[]

  @@map("vendors")
}

model Courier {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("couriers")
}

enum CompanyRole {
  OWNER
  STAFF
}

model Customer {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String?
  phone         String?
  /// HR, manager, admin, etc.
  jobTitle      String?
  companyId     String?
  companyRole   CompanyRole    @default(STAFF)
  paymentMethod PaymentMethod  @default(CREDIT_CARD)
  billingName     String?
  billingEmail    String?
  billingPhone    String?
  billingAddress  String?
  billingCity     String?
  billingPostcode String?
  billingState    String?
  cardholderName  String?
  cardBrand       String?
  cardLast4       String?
  cardExpMonth    Int?
  cardExpYear     Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  registeredCompanies Company[]    @relation("CompanyRegistrant")
  orders          Order[]
  recurringOrders RecurringOrder[]
  invitesCreated  CompanyInvite[]

  @@index([companyId])
  @@map("customers")
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id             String        @id @default(cuid())
  name           String        @unique
  billingEmail   String
  billingAddress String?
  phone          String?
  isActive       Boolean       @default(true)
  status         CompanyStatus @default(APPROVED)
  registeredById String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  registeredBy    Customer?        @relation("CompanyRegistrant", fields: [registeredById], references: [id], onDelete: SetNull)
  orders          Order[]
  invoices        Invoice[]
  recurringOrders RecurringOrder[]
  customers       Customer[]
  invites         CompanyInvite[]

  @@index([registeredById])
  @@map("companies")
}

/// Shareable link so staff can join and cover orders/payments.
model CompanyInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  companyId   String
  createdById String
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy Customer @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_invites")
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  category    String
  image       String
  badges      Json     @default("[]")
  available   Boolean  @default(true)
  /// Packs prepared for today. Optional; used as a starting leftover.
  dailyPackQty Int?
  /// Packs still in the kitchen. Null = no daily limit. Deducted when received.
  remainingQty Int?
  reviewStatus MenuReviewStatus @default(LIVE)
  rejectReason String?
  vendorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor     Vendor?     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("menu_items")
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique @default(dbgenerated())
  companyId           String
  vendorId            String?
  customerId          String?
  employeeName        String
  employeeEmail       String?
  employeePhone       String?
  department          String?
  deliveryLocation    String
  deliveryDate        DateTime      @default(now())
  deliveryTime        String?
  specialInstructions String?
  status              OrderStatus   @default(PENDING)
  subtotal            Float
  tax                 Float         @default(0)
  deliveryFee         Float         @default(0)
  total               Float
  paymentMethod       PaymentMethod @default(COMPANY_ACCOUNT)
  paymentStatus       PaymentStatus @default(PENDING)
  paidAt              DateTime?
  /// True after leftover packs were deducted (customer/vendor Receive).
  stockDeducted       Boolean       @default(false)
  /// Rider marked On the way / picked up.
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  delayReason         String?
  /// Photo proof (data URL or https) if delivery took more than 1 hour.
  delayProof          String?
  /// Kitchen pinged the rider; riderAckAt is set when they reply on the desk.
  riderNotifiedAt     DateTime?
  riderNotifyNote     String?
  riderAckAt          DateTime?
  courierId           String?
  /// Snapshot of the signed-in rider’s name for vendor and customer.
  courierName         String?
  invoiceId           String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  company  Company     @relation(fields: [companyId], references: [id])
  vendor   Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  courier  Courier?    @relation(fields: [courierId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  invoice  Invoice?    @relation(fields: [invoiceId], references: [id])

  @@index([customerId])
  @@index([courierId])

  @@map("orders")
}

model RecurringOrder {
  id                   String        @id @default(cuid())
  /// JS weekday: 0 Sunday … 6 Saturday (Asia/Kuching).
  weekday              Int
  vendorId             String
  companyId            String
  customerId           String?
  employeeName         String
  employeeEmail        String?
  employeePhone        String?
  department           String?
  deliveryLocation     String
  deliveryTime         String?
  specialInstructions  String?
  paymentMethod        PaymentMethod @default(COMPANY_ACCOUNT)
  /// [{ menuItemId, quantity, notes }]
  items                Json
  active               Boolean       @default(true)
  lastCreatedDate      DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  company  Company   @relation(fields: [companyId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([weekday, active])
  @@index([customerId])
  @@map("recurring_orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  quantity   Int
  price      Float
  notes      String?
  menuItemId String
  orderId    String

  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  @@map("order_items")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique @default(dbgenerated())
  companyId     String
  periodStart   DateTime
  periodEnd     DateTime
  totalAmount   Float
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  orders  Order[]

  @@map("invoices")
}

enum MenuReviewStatus {
  LIVE
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  HEADING_TO_VENDOR
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COMPANY_ACCOUNT
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}